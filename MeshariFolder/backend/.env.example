DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default provider priority — used for any tier without its own override
# below. Two or four entries both work — anything without a matching key
# below is skipped automatically.
LLM_PROVIDER_PRIORITY=anthropic,openai,deepseek,qwen

# Optional: route "main" (real judgment — Mentor's review, the Manager's
# plans/synthesis) and "small" (cheap/mechanical — onboarding suggestions,
# a roundtable specialist's quick comment) tasks through different
# provider priorities. This is what makes provider selection intelligent
# rather than one-size-fits-all: e.g. prefer your strongest provider for
# main-tier judgment calls, and your fastest/cheapest for small-tier ones.
# Leave blank to just use LLM_PROVIDER_PRIORITY above for that tier.
LLM_PROVIDER_PRIORITY_MAIN=anthropic,openai
LLM_PROVIDER_PRIORITY_SMALL=qwen,deepseek,anthropic

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_SMALL_MODEL=gpt-4o-mini

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SMALL_MODEL=deepseek-chat

# Qwen (Alibaba DashScope) — https://dashscope.console.aliyun.com
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_SMALL_MODEL=qwen-turbo
