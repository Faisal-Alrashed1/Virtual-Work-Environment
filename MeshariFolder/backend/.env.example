# Postgres connection string. For local dev without Postgres installed,
# you can temporarily use: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Generate a real secret for prod: `openssl rand -hex 32`
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Agent logic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5
